# virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# data: downloaded by the notebook, not committed
data/*
!data/.gitkeep

# model files: on Hugging Face, not on GitHub
*.onnx
*.pt
*.joblib
*.npy

# Cloudflare and Node
node_modules/
.wrangler/

# OS files
.DS_Store
Thumbs.db

# secrets: NEVER commit these
.env
.dev.vars
kaggle.json

# Do NOT ignore figures/, *.png or models/README.md: they must be on GitHub.

# gallery thumbnails (thousands of small files): on Hugging Face, not on GitHub
**/gallery_thumbs/
**/swatch_thumbs/
**/swatch_spheres/

# model server: the model and gallery are downloaded from Hugging Face at start-up
02_model_server/models/*
!02_model_server/models/config.json
.cache/
.pytest_cache/
