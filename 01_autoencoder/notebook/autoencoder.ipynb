    "ALL_CLASSES = [\"brick\", \"carpet\", \"ceramic\", \"fabric\", \"foliage\", \"food\", \"glass\", \"hair\", \"leather\",\n",
    "               \"metal\", \"mirror\", \"other\", \"painted\", \"paper\", \"plastic\", \"polishedstone\", \"skin\", \"sky\",\n",
    "               \"stone\", \"tile\", \"wallpaper\", \"water\", \"wood\"]          # label ids 0–22 (dataset card)\n",
    "BUILDING = [\"brick\", \"carpet\", \"ceramic\", \"glass\", \"metal\", \"mirror\", \"painted\", \"plastic\",\n",
    "            \"polishedstone\", \"stone\", \"tile\", \"wallpaper\", \"wood\"]\n",
    "OTHER = [c for c in ALL_CLASSES if c not in BUILDING]\n",
    "BUILDING_IDS = [ALL_CLASSES.index(c) for c in BUILDING]\n",
    "OTHER_IDS = [ALL_CLASSES.index(c) for c in OTHER]\n",
    "print(f\"{len(BUILDING)} building materials, {len(OTHER)} other classes\")\n",
    "\n",
    "\n",
    "def preprocess(image: Image.Image) -> np.ndarray:\n",
    "    # THE preprocessing, shared with the model server: RGB, centre square, 64 x 64, uint8 (H, W, 3)\n",
    "    image = image.convert(\"RGB\")\n",
    "    w, h = image.size\n",
    "    side = min(w, h)\n",
    "    left, top = (w - side) // 2, (h - side) // 2\n",
    "    image = image.crop((left, top, left + side, top + side))\n",
    "    image = image.resize((IMAGE_SIZE, IMAGE_SIZE), Image.BILINEAR)\n",
    "    return np.asarray(image, dtype=np.uint8)\n",
    "\n",
    "\n",
    "def load_split(split, label_ids, per_class=None):\n",
    "    # Read one split from the parquet files, keep some classes, decode and preprocess every image.\n",
    "    files = sorted(MINC_DIR.glob(f\"{split}-*.parquet\"))\n",
    "    assert files, f\"No parquet files for '{split}' in {MINC_DIR}. Download the data first.\"\n",
    "    df = (pl.scan_parquet(files)\n",
    "          .select(pl.col(\"image\").struct.field(\"bytes\").alias(\"bytes\"), pl.col(\"label\"))\n",
    "          .filter(pl.col(\"label\").is_in(label_ids))\n",
    "          .collect())\n",
    "    if per_class:\n",
    "        df = df.group_by(\"label\", maintain_order=True).head(per_class)\n",
    "    X = np.stack([preprocess(Image.open(io.BytesIO(b))) for b in df[\"bytes\"]])\n",
    "    return X, df[\"label\"].to_numpy()\n",
    "\n",
    "\n",
    "def load_cached(split, label_ids, name, per_class=None):\n",
    "    # Decoding ~30,000 JPEGs takes a minute or two: do it once and keep a cache in data/ (git-ignored)\n",
    "    cache = DATA_DIR / f\"minc64_{name}{'_quick' if QUICK else ''}.npz\"\n",
    "    if cache.exists():\n",
    "        d = np.load(cache)\n",
    "        return d[\"X\"], d[\"y\"]\n",
    "    start = time.time()\n",
    "    X, y = load_split(split, label_ids, per_class)\n",
    "    np.savez(cache, X=X, y=y)\n",
    "    print(f\"{split}/{name}: decoded {len(X):,} images in {time.time() - start:.0f} s -> {cache.name}\")\n",
    "    return X, y\n",
    "\n",
    "\n",
    "PER_CLASS = 200 if QUICK else None          # QUICK: 200 images per class\n",
    "remap = {orig: new for new, orig in enumerate(BUILDING_IDS)}   # original id -> 0..12\n",
    "\n",
    "X_train_u8, y_train_orig = load_cached(\"train\", BUILDING_IDS, \"train\", PER_CLASS)\n",
    "X_val_u8, y_val_orig = load_cached(\"validation\", BUILDING_IDS, \"val\", PER_CLASS and PER_CLASS // 4)\n",
    "X_test_u8, y_test_orig = load_cached(\"test\", BUILDING_IDS, \"test\", PER_CLASS and PER_CLASS // 4)\n",
    "X_other_u8, y_other_orig = load_cached(\"test\", OTHER_IDS, \"test_other\", PER_CLASS and PER_CLASS // 4)\n",
    "\n",
    "y_train = np.array([remap[v] for v in y_train_orig])\n",
    "y_val = np.array([remap[v] for v in y_val_orig])\n",
    "y_test = np.array([remap[v] for v in y_test_orig])\n",
    "\n",
    "print(f\"train {X_train_u8.shape} | validation {X_val_u8.shape} | test {X_test_u8.shape} | \"\n",
    "      f\"other-class test {X_other_u8.shape}\")\n",
    "pd.Series(np.bincount(y_train, minlength=len(BUILDING)), index=BUILDING, name=\"train patches\").to_frame().T"
   ]
