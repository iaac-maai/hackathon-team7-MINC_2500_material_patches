    "class DenseAE(nn.Module):\n",
    "    def __init__(self, latent_dim=64, hidden=256):\n",
    "        super().__init__()\n",
    "        n = 3 * IMAGE_SIZE * IMAGE_SIZE\n",
    "        self.latent_dim = latent_dim\n",
    "        self.encoder = nn.Sequential(nn.Flatten(), nn.Linear(n, hidden), nn.ReLU(), nn.Linear(hidden, latent_dim))\n",
    "        self.decoder = nn.Sequential(nn.Linear(latent_dim, hidden), nn.ReLU(), nn.Linear(hidden, n), nn.Sigmoid(),\n",
    "                                     nn.Unflatten(1, (3, IMAGE_SIZE, IMAGE_SIZE)))\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.decoder(self.encoder(x))\n",
    "\n",
    "\n",
    "class ConvAE(nn.Module):\n",
    "    def __init__(self, latent_dim=64):\n",
    "        super().__init__()\n",
    "        self.latent_dim = latent_dim\n",
    "        s = IMAGE_SIZE // 8                                                   # 64 -> 8\n",
    "        self.encoder = nn.Sequential(\n",
    "            nn.Conv2d(3, 32, 4, stride=2, padding=1), nn.ReLU(),            # 64 -> 32\n",
