    "class DenseAE(nn.Module):\n",
    "    def __init__(self, latent_dim=64, hidden=256):\n",
    "        super().__init__()\n",
    "        n = 3 * IMAGE_SIZE * IMAGE_SIZE\n",
    "        self.latent_dim = latent_dim\n",
    "        self.encoder = nn.Sequential(nn.Flatten(), nn.Linear(n, hidden), nn.ReLU(), nn.Linear(hidden, latent_dim))\n",
    "        self.decoder = nn.Sequential(nn.Linear(latent_dim, hidden), nn.ReLU(), nn.Linear(hidden, n), nn.Sigmoid(),\n",
    "                                     nn.Unflatten(1, (3, IMAGE_SIZE, IMAGE_SIZE)))\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.decoder(self.encoder(x))\n",
    "\n",
    "\n",
    "class ConvAE(nn.Module):\n",
    "    def __init__(self, latent_dim=64):\n",
    "        super().__init__()\n",
    "        self.latent_dim = latent_dim\n",
    "        s = IMAGE_SIZE // 8                                                   # 64 -> 8\n",
    "        self.encoder = nn.Sequential(\n",
    "            nn.Conv2d(3, 32, 4, stride=2, padding=1), nn.ReLU(),            # 64 -> 32\n",
    "            nn.Conv2d(32, 64, 4, stride=2, padding=1), nn.ReLU(),           # 32 -> 16\n",
    "            nn.Conv2d(64, 128, 4, stride=2, padding=1), nn.ReLU(),          # 16 -> 8\n",
    "            nn.Flatten(),\n",
    "            nn.Linear(128 * s * s, latent_dim),                              # the code\n",
    "        )\n",
    "        self.decoder = nn.Sequential(\n",
    "            nn.Linear(latent_dim, 128 * s * s), nn.ReLU(),\n",
    "            nn.Unflatten(1, (128, s, s)),\n",
    "            nn.ConvTranspose2d(128, 64, 4, stride=2, padding=1), nn.ReLU(),  # 8 -> 16\n",
    "            nn.ConvTranspose2d(64, 32, 4, stride=2, padding=1), nn.ReLU(),   # 16 -> 32\n",
    "            nn.ConvTranspose2d(32, 3, 4, stride=2, padding=1), nn.Sigmoid(), # 32 -> 64\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.decoder(self.encoder(x))\n",
    "\n",
    "\n",
    "def n_params(model):\n",
    "    return sum(p.numel() for p in model.parameters())\n",
    "\n",
    "\n",
    "for m in [DenseAE(64), ConvAE(32), ConvAE(128)]:\n",
    "    out = m(torch.zeros(2, 3, IMAGE_SIZE, IMAGE_SIZE))\n",
    "    print(f\"{type(m).__name__:8s} latent {m.latent_dim:4d}: {n_params(m):>10,} parameters, output {tuple(out.shape)}\")"
