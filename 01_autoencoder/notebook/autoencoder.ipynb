    "class MaterialAE(nn.Module):\n",
    "    # Wrapper for export: one call returns the reconstruction (for the unusual score) and the code (for search)\n",
    "    def __init__(self, ae):\n",
    "        super().__init__()\n",
    "        self.ae = ae\n",
    "\n",
    "    def forward(self, image):\n",
    "        code = self.ae.encoder(image)\n",
    "        return self.ae.decoder(code), code\n",
    "\n",
    "\n",
    "export_model = MaterialAE(models[BEST].cpu().eval()).eval()\n",
    "example_input = to_float(X_test[:1])\n",
    "onnx_path = MODEL_DIR / \"material_ae.onnx\"\n",
    "torch.onnx.export(export_model, (example_input,), onnx_path,\n",
    "                  input_names=[\"image\"], output_names=[\"reconstruction\", \"code\"],\n",
    "                  dynamic_shapes={\"image\": {0: torch.export.Dim(\"batch\")}}, external_data=False, verbose=False)\n",
    "shutil.copy(onnx_path, APP_DIR / \"material_ae.onnx\")\n",
    "torch.save(models[BEST].state_dict(), MODEL_DIR / \"material_ae.pt\")\n",
    "print(f\"{onnx_path}: {onnx_path.stat().st_size / 1e6:.1f} MB\")"
