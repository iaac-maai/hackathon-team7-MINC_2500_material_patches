    "def train_autoencoder(model, X_train, X_val, epochs=12, lr=1e-3, batch_size=128, verbose=True):\n",
    "    # Train an autoencoder to rebuild its input (MSE). X_* are uint8 tensors (N, 3, H, W).\n",
    "    torch.manual_seed(RANDOM_STATE)\n",
    "    model = model.to(DEVICE)\n",
    "    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n",
    "    loader = DataLoader(TensorDataset(X_train), batch_size=batch_size, shuffle=True,\n",
    "                        generator=torch.Generator().manual_seed(RANDOM_STATE))\n",
    "    history = []\n",
    "    start = time.time()\n",
    "    for epoch in range(1, epochs + 1):\n",
    "        model.train()\n",
    "        total = 0.0\n",
    "        for (batch,) in loader:\n",
    "            x = to_float(batch).to(DEVICE)\n",
    "            loss = nn.functional.mse_loss(model(x), x)\n",
    "            optimizer.zero_grad()\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "            total += loss.item() * len(x)\n",
    "        val_mse = reconstruction_error(model, X_val).mean().item()\n",
    "        history.append({\"epoch\": epoch, \"train_loss\": total / len(X_train), \"val_mse\": val_mse})\n",
    "        if verbose:\n",
    "            print(f\"epoch {epoch:2d}  train loss {total / len(X_train):.5f}  validation MSE {val_mse:.5f}\")\n",
    "    seconds = time.time() - start\n",
    "    print(f\"trained in {seconds:.0f} s\")\n",
    "    return model, pd.DataFrame(history), seconds\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def reconstruction_error(model, X, batch_size=500):\n",
    "    # One number per image: mean squared difference between input and output\n",
    "    model.eval()\n",
    "    errors = []\n",
    "    for i in range(0, len(X), batch_size):\n",
    "        x = to_float(X[i:i + batch_size]).to(DEVICE)\n",
    "        errors.append(((model(x) - x) ** 2).mean(dim=(1, 2, 3)).cpu())\n",
    "    return torch.cat(errors)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def reconstruct(model, X, batch_size=500):\n",
    "    model.eval()\n",
    "    return torch.cat([model(to_float(X[i:i + batch_size]).to(DEVICE)).cpu() for i in range(0, len(X), batch_size)])\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def encode(model, X, batch_size=500):\n",
    "    # Images -> latent codes (numpy, N x latent_dim)\n",
    "    model.eval()\n",
    "    return torch.cat([model.encoder(to_float(X[i:i + batch_size]).to(DEVICE)).cpu()\n",
    "                      for i in range(0, len(X), batch_size)]).numpy()\n",
    "\n",
    "\n",
    "def precision_at_k(Z_gallery, y_gallery, Z_query, y_query, k=5):\n",
    "    # Share of the k nearest gallery codes that have the same material as the query.\n",
    "    # The AE never saw the labels: this measures whether its latent space groups materials.\n",
    "    nn_index = NearestNeighbors(n_neighbors=k).fit(Z_gallery)\n",
    "    _, idx = nn_index.kneighbors(Z_query)\n",
    "    hits = y_gallery[idx] == y_query[:, None]\n",
    "    return hits.mean(), hits.mean(axis=1)"
